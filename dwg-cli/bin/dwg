#!/usr/bin/env node
/*
 * dwg — CLI de controlo/debug do dsh-work-game.
 * Contrato: docs/contratos-plugin.md §4 · manual: docs/terminal.md.
 *
 * Este ficheiro SÓ despacha: instala o filtro do aviso cosmético de módulo
 * "typeless" do Node, carrega os comandos e entrega o exit code ao processo.
 */

// O pacote não declara "type":"module"; o Node volta a analisar os .js como
// ESM por deteção de sintaxe e emite um aviso inofensivo (code
// MODULE_TYPELESS_PACKAGE_JSON) sempre que um comando mantém o processo vivo
// o suficiente para o event loop o entregar. Intercetar na origem — um
// listener do evento "warning" não suprime a impressão por defeito.
const emitirAvisoOriginal = process.emitWarning;
process.emitWarning = function filtroAvisos(aviso, tipo, codigo) {
  const chave =
    (typeof aviso === 'object' && aviso !== null && aviso.code) ||
    (typeof tipo === 'object' && tipo !== null ? tipo.code : codigo);
  if (chave !== 'MODULE_TYPELESS_PACKAGE_JSON') {
    emitirAvisoOriginal.call(process, aviso, tipo, codigo);
  }
};

const { run } = await import('../lib/commands.js');

const codigo = await run(process.argv.slice(2));
// Num pipe a escrita do stdout é assíncrona: process.exit() logo a seguir a
// uma saída grande cortava-a a meio (ex.: `dwg logs --json | …` com o
// logs/dwg.log acima de 64 KB → última linha JSON truncada). Sair só depois
// de o stdout esvaziar.
process.stdout.write('', () => process.exit(codigo));
